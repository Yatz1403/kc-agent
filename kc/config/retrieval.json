  "cache": {"enabled": true, "strategy": "epoch"},
  "health_targets": {
    "coverage": 0.8,
    "freshness": 0.5,
    "confidence": 0.7,
    "gap_closure": 0.6,
    "llm_free_ingestion": 0.85
  },
  "guardrails": {
    "agent_derived_ratio_max": 0.15,
    "source_skip_rate_max": 0.05,
    "merge_precision_min": 0.99
  }
}
